__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
dist/
build/

# Data + outputs
data/
runs/
# reference_runs/ is EXPLICITLY TRACKED — it is the in-repo reproducibility
# artifact for the paid LLM-agent runs (see README "Why the checkout is large").
#
# ...but only the llm_agent runs. Those cost money and ship an llm_cache that
# replays them for $0, so they are worth their size. The zero-dollar baselines
# below regenerate from the scenario YAML + --seed in about a minute each, so
# committing them would add ~40 MB of derivable data to a PUBLIC repo for no
# provenance gain — their provenance is the recorded number plus the command.
# Ignoring them explicitly also stops a stray `git add -A` from doing it by
# accident, which is the real reason this rule exists.
reference_runs/*/round_robin/
reference_runs/*/llm_fallback/
reference_runs/*/lp_optimal/
reference_runs/*/no_coordination/
reference_runs/*/round_robin_overlay/

# Env
.env
.env.local
*.envrc

# Local working files (not part of the public project)
CLAUDE.md
internal/
.superpowers/

# Editor
.DS_Store
.vscode/
.idea/

# Phase 4b web demo (SvelteKit)
web/node_modules/
web/.svelte-kit/
web/build/
# The `data/` rule above matches any directory named data at any depth, which
# would silently swallow the demo's committed payload. Re-include it explicitly.
!web/static/data/
